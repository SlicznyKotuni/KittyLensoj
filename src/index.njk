---
layout: layout.njk
title: Kitty Lensoj
---

<header class="page-header">
    <h1>Kitty Lensoj</h1>
    <p class="subtitle">Kitty Lensoj - Trezorkesto de Kato</p>
</header>

<main class="main-content-with-sidebar">
    <!-- Tags sidebar on the right -->
    <aside class="tags-sidebar" id="tags-sidebar">
        <div class="sidebar-header">
            <h3>Tagi</h3>
            <button id="clear-filters" class="clear-filters-btn" style="display: none;">Vyčistit vše</button>
        </div>
        <input 
            type="text" 
            id="tag-search" 
            class="tag-search-input" 
            placeholder="Szukaj tagu..." 
            aria-label="Wyszukiwanie tagów"
        >
        <div class="tags-container" id="tags-container">
            <!-- Tags will be generated by JavaScript -->
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">
        <div class="grid" id="lens-grid">
            {% for lens in collections.lenses %}
            <div class="tile" data-lens-index="{{ loop.index0 }}" {% if lens.data.tags %}data-tags="{{ lens.data.tags | join(',') }}"{% endif %}>
                <div class="tile-content" onclick="location.href='{{ lens.url }}'">
                    <div class="tile-title">{{ lens | displayName }}</div>
                    <span class="file-title">{{ lens.fileSlug }}</span>
                    {% if lens.data.tags %}
                    <div class="tile-tags">
                        {% for tag in lens.data.tags %}
                        <span class="tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        
        <div id="no-results" class="no-lenses" style="display: none;">
            <h2>Brak wyników</h2>
            <p>Brak obiektywów z wybranym tagiem.</p>
        </div>
    </div>
</main>

<footer class="page-footer">
    <p>&copy; 2025 Kitty Lensoj - Ĉiuj rajtoj rezervitaj</p>
    <p class="stats">Lensoj: <span id="lens-count">{{ collections.lenses.length }}</span></p>
</footer>

<!-- Pass lens data to JavaScript -->
<script>
window.lensesData = [
    {% for lens in collections.lenses %}
    {
        tags: [{% if lens.data.tags %}{% for tag in lens.data.tags %}"{{ tag }}"{{ "," if not loop.last }}{% endfor %}{% endif %}],
        index: {{ loop.index0 }}
    }{{ "," if not loop.last }}
    {% endfor %}
];
</script>

<script src="/js/tag-filter.js"></script>