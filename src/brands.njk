---
layout: layout.njk
title: Marko
permalink: /producenci/
---

<header class="page-header">
    <h1>Markoj da lensoj</h1>
    <p class="subtitle">Historja kaj karaktero de fabrikantoj</p>
</header>

<main class="main-content">
    <div class="grid" id="brands-grid">
        {% for brand in collections.brands %}
        <div class="tile">
            <a href="{{ brand.url }}" class="tile-content">
                <div class="tile-title">{{ brand | displayName }}</div>
                <span class="file-title">{{ brand.fileSlug }}</span>
            </a>
        </div>
        {% endfor %}
    </div>
</main>

<footer class="page-footer">
    <p>&copy; 2025 Kitty Lensoj - Ĉiuj rajtoj rezervitaj</p>
    <p class="stats">Producentoj: {{ collections.brands.length }}</p>
</footer>
