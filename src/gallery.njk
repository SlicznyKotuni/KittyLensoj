---
layout: layout.njk
title: Galerio
permalink: /galeria/
---

<header class="page-header">
    <h1>Galerio</h1>
    <p class="subtitle">Foliumi fotojn per lenso</p>
</header>

<main class="main-content">
    <div class="gallery-controls">
        <label for="folder-select">Elektu lenson:</label>
        <select id="folder-select" class="folder-select">
            <option value="all">Ĉiuj lensoj</option>
            {% for folder in collections.imageFolders %}
            <option value="{{ folder }}">{{ folder }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="gallery-grid" id="gallery-grid">
        {% for image in collections.allImages %}
        <div class="gallery-item" data-lens="{{ image.lens }}">
            {# Use generated responsive thumbnails; thumbnails below the fold load lazily.
               We approximate 'below the fold' by making the first 6 images eager. #}
            <img
                src="{{ image.thumb.src }}"
                srcset="{{ image.thumb.srcset }}"
                sizes="{{ image.thumb.sizes }}"
                alt="{{ image.lens }} - {{ image.filename }}"
                data-full="{{ image.path }}"
                loading="{{ 'eager' if loop.index0 < 6 else 'lazy' }}"
                decoding="async"
                fetchpriority="{{ 'high' if loop.index0 < 6 else 'low' }}"
                class="gallery-img"
                {% if image.thumb.width %} width="{{ image.thumb.width }}"{% endif %}
                {% if image.thumb.height %} height="{{ image.thumb.height }}"{% endif %}
            >
            <div class="image-info">
                <span class="lens-name">{{ image.lens }}</span>
                <span class="file-title">{{ image.filename }}</span>
            </div>
        </div>
        {% endfor %}
    </div>
</div>