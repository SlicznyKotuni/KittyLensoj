---
layout: layout.njk
title: Galerio
permalink: /galeria/
---

<header class="page-header">
    <h1>Galerio</h1>
    <p class="subtitle">Foliumi fotojn per lenso</p>
</header>

<main class="main-content">
    <div class="gallery-controls">
        <label for="folder-select">Elektu lenson:</label>
        <select id="folder-select" class="folder-select">
            <option value="all">Ĉiuj lensoj</option>
            {% for folder in collections.imageFolders %}
            <option value="{{ folder }}">{{ folder }}</option>
            {% endfor %}
        </select>
        <p class="gallery-status" id="gallery-status" aria-live="polite">Ŝargas galerion…</p>
    </div>

    <div class="gallery-grid" id="gallery-grid"></div>
    <div id="gallery-sentinel" class="gallery-sentinel" aria-hidden="true"></div>
</main>
