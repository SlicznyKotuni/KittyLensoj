---
layout: layout.njk
title: Lastaj photoj
permalink: /lastaj-photoj/
---
{% from "gallery-item.njk" import galleryItem %}

<header class="page-header">
    <h1>Lastaj photoj</h1>
    <p class="subtitle">Kvindek hazardaj elektitaj fotoj en nia retejo</p>
</header>

<main class="main-content">
    {# Embed all images data as JSON for JavaScript access #}
    <script type="application/json" id="all-images-data">
    {{ collections.allImages | dump | safe }}
    </script>

    <div class="gallery-controls">
        
        <button id="shuffle-btn" class="shuffle-btn">🔀 Losuj ponownie</button>
    </div>

    <div class="gallery-grid" id="gallery-grid">
        {# Shuffle all images and take first 50 #}
        {% set randomImages = collections.allImages | shuffle %}
        {% for image in randomImages %}
            {% if loop.index0 < 50 %}
        {{ galleryItem(image) }}
            {% endif %}
        {% endfor %}
    </div>
</main>
