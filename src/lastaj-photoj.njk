---
layout: layout.njk
title: Lastaj photoj
permalink: /lastaj-photoj/
---

<header class="page-header">
    <h1>Lastaj photoj</h1>
    <p class="subtitle">Kvindek hazardaj elektitaj fotoj en nia retejo</p>
</header>

<main class="main-content">
    <div class="gallery-controls">
        
        <button id="shuffle-btn" class="shuffle-btn">🔀 Losuj ponownie</button>
    </div>

    <div class="gallery-grid" id="gallery-grid">
        {# Shuffle all images and take first 50 #}
        {% set randomImages = collections.allImages | shuffle %}
        {% for image in randomImages %}
            {% if loop.index0 < 50 %}
        <div class="gallery-item" data-lens="{{ image.lens }}">
            <img
                src="{{ image.thumb.src }}"
                srcset="{{ image.thumb.srcset }}"
                sizes="{{ image.thumb.sizes }}"
                alt="{{ image.lens }} - {{ image.filename }}"
                data-full="{{ image.path }}"
                loading="{{ 'lazy' }}"
                decoding="async"
                fetchpriority="{{ 'low' }}"
                class="gallery-img"
                {% if image.thumb.width %} width="{{ image.thumb.width }}"{% endif %}
                {% if image.thumb.height %} height="{{ image.thumb.height }}"{% endif %}
            >
            <div class="image-info">
                <span class="lens-name">{{ image.lens }}</span>
                <span class="file-title">{{ image.filename }}</span>
            </div>
        </div>
            {% endif %}
        {% endfor %}
    </div>
</main>
